{
  "name": "@easytrip/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-with-env.mjs nest start --watch",
    "build": "nest build",
    "start": "node scripts/run-with-env.mjs node dist/main.js",
    "db:generate": "node scripts/run-with-env.mjs prisma generate",
    "db:migrate": "node scripts/run-with-env.mjs prisma migrate dev",
    "db:deploy": "node scripts/run-with-env.mjs prisma migrate deploy",
    "db:reset": "node scripts/run-with-env.mjs prisma migrate reset --force",
    "db:seed": "node scripts/run-with-env.mjs tsx prisma/seed.ts",
    "test": "jest",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config jest-e2e.json --runInBand"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@easytrip/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.3.1",
    "argon2": "^0.41.1",
    "exceljs": "^4.4.0",
    "pdfmake": "^0.2.23",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/pdfmake": "^0.2.13",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
