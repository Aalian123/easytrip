// EasyTrip — Fleet & Car Rental Management
//
// Guiding rule for this schema: current state is derivable, history is not.
// Assignments, inspections, maintenance, fuel card holdings and timeline events
// are append-only — nothing here is ever rewritten to reflect a newer truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

enum Role {
  ADMIN
  FLEET_MANAGER
  ACCOUNTS
  RIDER
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A RIDER user is the login for exactly one rider profile.
  rider   Rider?  @relation(fields: [riderId], references: [id], onDelete: SetNull)
  riderId String? @unique

  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  mediaLinks      MediaLink[]
  documents       Document[]
  vehicleEvents   VehicleEvent[]
  riderEvents     RiderEvent[]
  notifications   Notification[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------- fleet

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  RESERVED
  MAINTENANCE
  DAMAGED
  ACCIDENT
  OUT_OF_SERVICE
  INACTIVE
}

enum PlateType {
  WHITE
  YELLOW
}

// The driving licence a rider must hold to take the vehicle out.
enum LicenceClass {
  MOTORBIKE
  PRIVATE
  LIGHT_TRANSPORT
  HEAVY_TRANSPORT
}

model Vehicle {
  id             String        @id @default(uuid())
  registration   String        @unique
  make           String
  model          String
  year           Int
  color          String
  category       String
  plateType      PlateType     @default(WHITE)
  licenceClass   LicenceClass  @default(PRIVATE)
  engineNumber   String?
  chassisNumber  String?
  purchaseDate   DateTime?
  currentMileage Int           @default(0)
  status         VehicleStatus @default(AVAILABLE)
  notes          String?

  // Engine oil tracking (FR-14). Derived values are computed, never stored.
  lastOilChangeDate    DateTime?
  lastOilChangeMileage Int?
  oilChangeIntervalKm  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentalRates   RentalRate[]
  assignments   VehicleAssignment[]
  inspections   Inspection[]
  damages       Damage[]
  accidents     Accident[]
  maintenance   MaintenanceRecord[]
  fuelCardAssignments FuelCardAssignment[]
  fuelTransactions    FuelTransaction[]
  mediaLinks    MediaLink[]
  events        VehicleEvent[]
  reservations  Reservation[]
  rentalCharges RentalCharge[]

  @@index([status])
  @@index([registration])
}

// Rates are historised: a new row supersedes the previous one, so a rental
// billed last month keeps the figures it was billed at.
model RentalRate {
  id                  String   @id @default(uuid())
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId           String
  dailyRate           Decimal  @db.Decimal(12, 2)
  weeklyRate          Decimal? @db.Decimal(12, 2)
  monthlyRate         Decimal? @db.Decimal(12, 2)
  securityDeposit     Decimal? @db.Decimal(12, 2)
  lateReturnFeePerDay Decimal? @db.Decimal(12, 2)
  effectiveFrom       DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([vehicleId, effectiveFrom])
}

// ---------------------------------------------------------------- riders

enum RiderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
}

model Rider {
  id                     String      @id @default(uuid())
  fullName               String
  nationalId             String      @unique
  contactNumber          String
  address                String?
  emergencyContactName   String?
  emergencyContactNumber String?
  licenceNumber          String?
  licenceIssuedAt        DateTime?
  licenceExpiresAt       DateTime?
  employmentStatus       String?
  status                 RiderStatus @default(ACTIVE)
  notes                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  user                User?
  assignments         VehicleAssignment[]
  damages             Damage[]
  accidents           Accident[]
  fuelCardAssignments FuelCardAssignment[]
  fuelTransactions    FuelTransaction[]
  mediaLinks          MediaLink[]
  events              RiderEvent[]
  reservations        Reservation[]

  @@index([status])
  @@index([fullName])
}

// ---------------------------------------------------------------- operations

enum AssignmentStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

model VehicleAssignment {
  id        String           @id @default(uuid())
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleId String
  rider     Rider            @relation(fields: [riderId], references: [id], onDelete: Restrict)
  riderId   String
  status    AssignmentStatus @default(ACTIVE)

  assignedAt       DateTime
  expectedReturnAt DateTime?
  returnedAt       DateTime?

  startMileage   Int
  startFuelLevel Int? // eighths of a tank, 0-8
  endMileage     Int?
  endFuelLevel   Int?

  // The rate that applied the day this vehicle went out, frozen at assignment.
  rateSnapshot Json?

  fuelCard   FuelCard? @relation(fields: [fuelCardId], references: [id], onDelete: SetNull)
  fuelCardId String?

  notes       String?
  returnNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections   Inspection[]
  damages       Damage[]
  accidents     Accident[]
  mediaLinks    MediaLink[]
  events        VehicleEvent[]
  rentalCharge  RentalCharge?

  @@index([vehicleId, status])
  @@index([riderId, status])
  @@index([assignedAt])
}

enum InspectionType {
  HANDOVER
  RETURN
}

// Immutable once submitted (BR-05): the handover record is the evidence the
// return is compared against, so it can never be edited after the fact.
model Inspection {
  id           String            @id @default(uuid())
  type         InspectionType
  assignment   VehicleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleId    String

  mileage   Int
  fuelLevel Int?

  // One row per CHECKLIST_ITEMS key: { exterior: { grade, note }, ... }
  checklist Json

  existingDamageNotes String?
  accessoriesNotes    String?
  documentsProvided   Boolean @default(true)
  notes               String?

  inspectedById String?
  inspectedAt   DateTime @default(now())
  submittedAt   DateTime?

  mediaLinks MediaLink[]

  @@index([assignmentId, type])
  @@index([vehicleId])
}

model Reservation {
  id         String   @id @default(uuid())
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId  String
  rider      Rider?   @relation(fields: [riderId], references: [id], onDelete: SetNull)
  riderId    String?
  startsAt   DateTime
  endsAt     DateTime
  notes      String?
  cancelledAt DateTime?
  createdAt  DateTime @default(now())

  @@index([vehicleId, startsAt])
}

// ---------------------------------------------------------------- incidents

enum DamageCategory {
  SCRATCH
  DENT
  GLASS
  TYRE
  INTERIOR
  MECHANICAL
  ELECTRICAL
  MISSING_ACCESSORY
  OTHER
}

enum DamageSeverity {
  MINOR
  MODERATE
  SEVERE
}

enum RepairStatus {
  PENDING
  IN_PROGRESS
  REPAIRED
  WRITTEN_OFF
  NOT_REQUIRED
}

enum ResponsibleParty {
  RIDER
  THIRD_PARTY
  SHARED
  COMPANY
  UNDETERMINED
}

model Damage {
  id           String             @id @default(uuid())
  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleId    String
  rider        Rider?             @relation(fields: [riderId], references: [id], onDelete: SetNull)
  riderId      String?
  assignment   VehicleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId String?
  accident     Accident?          @relation(fields: [accidentId], references: [id], onDelete: SetNull)
  accidentId   String?

  detectedAt      DateTime
  category        DamageCategory
  severity        DamageSeverity   @default(MINOR)
  description     String
  estimatedCost   Decimal?         @db.Decimal(12, 2)
  actualCost      Decimal?         @db.Decimal(12, 2)
  responsibleParty ResponsibleParty @default(UNDETERMINED)
  repairStatus    RepairStatus     @default(PENDING)
  chargedToRider  Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mediaLinks MediaLink[]

  @@index([vehicleId, detectedAt])
  @@index([assignmentId])
}

enum AccidentStatus {
  REPORTED
  UNDER_INVESTIGATION
  INSURANCE_SUBMITTED
  UNDER_REPAIR
  RESOLVED
  CLOSED
}

model Accident {
  id           String             @id @default(uuid())
  reference    String             @unique
  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleId    String
  rider        Rider?             @relation(fields: [riderId], references: [id], onDelete: SetNull)
  riderId      String?
  assignment   VehicleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId String?

  occurredAt     DateTime
  location       String
  description    String
  riderStatement String?
  thirdParty     Json?
  policeReport   String?
  insuranceInfo  String?

  estimatedRepairCost Decimal?         @db.Decimal(12, 2)
  actualRepairCost    Decimal?         @db.Decimal(12, 2)
  responsibility      ResponsibleParty @default(UNDETERMINED)
  managementComments  String?
  status              AccidentStatus   @default(REPORTED)
  resolvedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  damages    Damage[]
  mediaLinks MediaLink[]

  @@index([vehicleId, occurredAt])
  @@index([status])
}

// ---------------------------------------------------------------- maintenance

enum MaintenanceType {
  ENGINE_OIL
  OIL_FILTER
  AIR_FILTER
  BRAKE_PADS
  TYRES
  BATTERY
  SUSPENSION
  GENERAL_SERVICE
  REPAIR
  OTHER
}

// Insert-only (BR-08). Correcting a record means adding another one.
model MaintenanceRecord {
  id        String          @id @default(uuid())
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleId String
  type      MaintenanceType
  performedAt DateTime
  mileage     Int
  serviceProvider String?
  partsReplaced   String?
  description     String?
  cost            Decimal? @db.Decimal(12, 2)
  invoiceUrl      String?
  nextServiceDate    DateTime?
  nextServiceMileage Int?
  createdAt DateTime @default(now())

  mediaLinks MediaLink[]

  @@index([vehicleId, performedAt])
  @@index([type])
}

// ---------------------------------------------------------------- fuel

enum FuelCardStatus {
  AVAILABLE
  ASSIGNED
  BLOCKED
  LOST
  EXPIRED
  INACTIVE
}

model FuelCard {
  id           String         @id @default(uuid())
  cardNumber   String         @unique
  provider     String
  expiryDate   DateTime?
  status       FuelCardStatus @default(AVAILABLE)
  dailyLimit   Decimal?       @db.Decimal(12, 2)
  weeklyLimit  Decimal?       @db.Decimal(12, 2)
  monthlyLimit Decimal?       @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assignments  FuelCardAssignment[]
  transactions FuelTransaction[]
  vehicleAssignments VehicleAssignment[]

  @@index([status])
}

// Append-only holding history (BR-09). The current holder is the row with a
// null releasedAt, guaranteed unique per card by a partial index.
model FuelCardAssignment {
  id         String    @id @default(uuid())
  fuelCard   FuelCard  @relation(fields: [fuelCardId], references: [id], onDelete: Cascade)
  fuelCardId String
  rider      Rider?    @relation(fields: [riderId], references: [id], onDelete: SetNull)
  riderId    String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId  String?
  assignedAt DateTime  @default(now())
  releasedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([fuelCardId, assignedAt])
  @@index([riderId])
}

model FuelTransaction {
  id            String   @id @default(uuid())
  fuelCard      FuelCard @relation(fields: [fuelCardId], references: [id], onDelete: Restrict)
  fuelCardId    String
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId     String?
  rider         Rider?   @relation(fields: [riderId], references: [id], onDelete: SetNull)
  riderId       String?
  occurredAt    DateTime
  station       String?
  litres        Decimal  @db.Decimal(10, 2)
  amount        Decimal  @db.Decimal(12, 2)
  vehicleMileage Int?
  receiptUrl    String?
  notes         String?
  flagged       Boolean  @default(false)
  flagReason    String?
  createdAt     DateTime @default(now())

  @@index([fuelCardId, occurredAt])
  @@index([vehicleId, occurredAt])
}

// ---------------------------------------------------------------- money

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
}

model RentalCharge {
  id           String            @id @default(uuid())
  assignment   VehicleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String            @unique
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleId    String

  billedDays Int
  lateDays   Int     @default(0)
  // The priced lines exactly as calculated, kept for the invoice trail.
  lines      Json

  baseAmount        Decimal @db.Decimal(12, 2)
  lateFee           Decimal @db.Decimal(12, 2) @default(0)
  fuelCharge        Decimal @db.Decimal(12, 2) @default(0)
  damageCharge      Decimal @db.Decimal(12, 2) @default(0)
  trafficFines      Decimal @db.Decimal(12, 2) @default(0)
  otherCharges      Decimal @db.Decimal(12, 2) @default(0)
  discount          Decimal @db.Decimal(12, 2) @default(0)
  totalAmount       Decimal @db.Decimal(12, 2)
  paymentStatus     PaymentStatus @default(UNPAID)
  paidAmount        Decimal @db.Decimal(12, 2) @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, createdAt])
  @@index([paymentStatus])
}

// ---------------------------------------------------------------- evidence

enum MediaCategory {
  REGISTRATION
  HANDOVER
  RETURN
  ACCIDENT
  DAMAGE
  MAINTENANCE
  REPAIR
  INSPECTION
}

// Evidence is linked, never uploaded: the platform stores the URL of a file
// that lives in the operator's own drive.
model MediaLink {
  id          String        @id @default(uuid())
  url         String
  provider    String        @default("OTHER")
  category    MediaCategory
  description String?

  vehicle       Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId     String?
  rider         Rider?             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId       String?
  assignment    VehicleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId  String?
  inspection    Inspection?        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId  String?
  accident      Accident?          @relation(fields: [accidentId], references: [id], onDelete: Cascade)
  accidentId    String?
  damage        Damage?            @relation(fields: [damageId], references: [id], onDelete: Cascade)
  damageId      String?
  maintenance   MaintenanceRecord? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  maintenanceId String?

  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([vehicleId, category])
  @@index([assignmentId])
}

enum DocumentOwnerType {
  VEHICLE
  RIDER
}

model Document {
  id        String            @id @default(uuid())
  ownerType DocumentOwnerType
  ownerId   String
  docType   String
  title     String
  url       String
  issuedAt  DateTime?
  expiresAt DateTime?
  notes     String?

  addedBy   User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  addedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerType, ownerId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- history

enum VehicleEventType {
  VEHICLE_ADDED
  STATUS_CHANGED
  ASSIGNED
  HANDOVER_INSPECTED
  RETURNED
  RETURN_INSPECTED
  DAMAGE_RECORDED
  ACCIDENT_REPORTED
  ACCIDENT_UPDATED
  MAINTENANCE_PERFORMED
  OIL_CHANGED
  FUEL_CARD_ASSIGNED
  FUEL_CARD_RELEASED
  FUEL_PURCHASED
  DOCUMENT_ADDED
  RENTAL_CHARGED
  NOTE_ADDED
}

// The vehicle timeline (FR-07). Written inside the same transaction as the
// change it describes, and never updated or deleted afterwards.
model VehicleEvent {
  id         String           @id @default(uuid())
  vehicle    Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId  String
  type       VehicleEventType
  occurredAt DateTime         @default(now())
  summary    String
  payload    Json?

  assignment   VehicleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId String?
  actor        User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId      String?
  createdAt    DateTime           @default(now())

  @@index([vehicleId, occurredAt])
  @@index([type])
}

enum RiderEventType {
  RIDER_ADDED
  STATUS_CHANGED
  VEHICLE_ASSIGNED
  VEHICLE_RETURNED
  FUEL_CARD_ASSIGNED
  FUEL_CARD_RELEASED
  ACCIDENT_REPORTED
  DAMAGE_RECORDED
  DOCUMENT_ADDED
}

model RiderEvent {
  id         String         @id @default(uuid())
  rider      Rider          @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId    String
  type       RiderEventType
  occurredAt DateTime       @default(now())
  summary    String
  payload    Json?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  createdAt  DateTime       @default(now())

  @@index([riderId, occurredAt])
}

// ---------------------------------------------------------------- alerts

enum NotificationType {
  OIL_CHANGE_DUE
  MAINTENANCE_DUE
  INSURANCE_EXPIRING
  REGISTRATION_EXPIRING
  LICENCE_EXPIRING
  DOCUMENT_EXPIRING
  VEHICLE_OVERDUE
  FUEL_CARD_EXPIRING
  FUEL_LIMIT_REACHED
  ACCIDENT_REPORTED
  DAMAGE_REPORTED
  VEHICLE_RETURNED
  VEHICLE_AVAILABLE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id        String               @id @default(uuid())
  type      NotificationType
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String?
  // Stable key so the nightly generator can re-run without duplicating alerts.
  dedupeKey String               @unique

  entityType String?
  entityId   String?
  dueAt      DateTime?

  targetRole Role?
  targetUser User?   @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId String?

  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([targetRole, readAt])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------- audit

// Written by the Prisma audit extension only. No API route updates or deletes
// these rows (FR-24).
model AuditLog {
  id         String   @id @default(uuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  userLabel  String?
  action     String
  module     String
  recordType String
  recordId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([recordType, recordId])
  @@index([createdAt])
  @@index([module])
}

// ---------------------------------------------------------------- settings

// Single row, id fixed to "settings". Currency and the identification label are
// configurable so the platform is not tied to one country.
model Settings {
  id                             String   @id @default("settings")
  organizationName               String   @default("EasyTrip Fleet")
  currencyCode                   String   @default("USD")
  currencySymbol                 String   @default("$")
  nationalIdLabel                String   @default("ID number")
  defaultOilIntervalKm           Int      @default(5000)
  oilWarnWithinKm                Int      @default(500)
  alertLeadDays                  Int      @default(30)
  allowMultipleActiveAssignments Boolean  @default(false)
  updatedAt                      DateTime @updatedAt
}
