# Copy this file to .env at the repo root:  cp env.example .env

# Database (docker compose maps postgres to host port 5433)
DATABASE_URL="postgresql://easytrip:easytrip@localhost:5433/easytrip?schema=public"

# API
API_PORT=3100
WEB_ORIGIN="http://localhost:3101"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Seed admin account
SEED_ADMIN_EMAIL="admin@easytrip.local"
SEED_ADMIN_PASSWORD="admin12345"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3100"

# ---------------------------------------------------------------------------
# Features
#
# Which parts of the platform are switched on. This is the only place they are
# decided: the API refuses a switched-off feature, and the menu does not show
# it. Change a value here and restart the API to show a client a different
# slice of the product.
#
# FEATURES sets the baseline — "all", or a comma-separated list of what to show.
# A FEATURE_* line then overrides one feature either way.
#
# Anything a feature depends on has to be in the list too, or it is left off:
# payments needs rentals, which needs assignments; fuelTransactions needs
# fuelCards; inspections needs assignments.
#
# Turn them on in this order as each part is signed off:
#   1  fleet, riders            the fleet and the people (always on)
#   2  documents                registration, insurance, licences
#   3  assignments, inspections handovers, returns and the condition checks
#   4  incidents                accidents and damage
#   5  maintenance              servicing and oil, tracked by distance
#   6  fuelCards, fuelTransactions
#   7  rentals, payments
#   8  alerts                   the daily sweep
#   9  reports, audit           management reporting
#
# Example — a demo of the first three steps only:
#   FEATURES=fleet,riders,documents,assignments,inspections
FEATURES=all

# Per-feature overrides. Accepts true/false, on/off, yes/no, 1/0.
# FEATURE_DOCUMENTS=true
# FEATURE_ASSIGNMENTS=true
# FEATURE_INSPECTIONS=true
# FEATURE_INCIDENTS=false
# FEATURE_MAINTENANCE=false
# FEATURE_FUEL_CARDS=false
# FEATURE_FUEL_TRANSACTIONS=false
# FEATURE_RENTALS=false
# FEATURE_PAYMENTS=false
# FEATURE_ALERTS=false
# FEATURE_REPORTS=false
# FEATURE_AUDIT=false
